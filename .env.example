POSTGRES_USER=visauser
POSTGRES_PASSWORD=visapass
POSTGRES_DB=visamap
POSTGRES_HOST=localhost
POSTGRES_PORT=5442

REDIS_HOST=localhost
REDIS_PORT=6379

API_KEY=your-secret-key-here

# Пороги safety_final_score (0..100) → safety_level при PUT /admin/countries/safety-final-scores
# score >= SAFETY_SCORE_SAFE_MIN → safe; >= SAFETY_SCORE_UNSAFE_MIN → unsafe; иначе dangerous
# SAFETY_SCORE_SAFE_MIN=70
# SAFETY_SCORE_UNSAFE_MIN=40

INPUT_FOLDER_SEASONS="\input_data\seasons"

# Direct flights

FLIGHTS_DATA_SOURCE=openflights
FLIGHTS_CACHE_TTL_SECONDS=86400
FLIGHTS_REFRESH_LEAD_SECONDS=3600
FLIGHTS_REFRESH_MIN_REQUESTS=1
FLIGHTS_REFRESH_BATCH_SIZE=20
FLIGHTS_PROBE_DATE_OFFSET_DAYS=30
FLIGHTS_PROBE_MAX_CONCURRENT=5
FLIGHTS_PROBE_DELAY_MS=200
OPENFLIGHTS_DATA_DIR=./data/openflights
# AVIATION_EDGE_API_KEY=
# IGNAV_API_KEY=

